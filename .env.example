# Скопируйте в .env и заполните: cp .env.example .env

# --- приложение ---
# Публичный адрес приложения (используется в ссылках и письмах)
APP_URL=http://localhost:8080
# Порт приложения на хосте
APP_PORT=8080

# Доступ администратора (обязательно смените)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Секрет для подписи сессий (32+ случайных символов; без него сессии слетают при рестарте)
# Сгенерировать: openssl rand -hex 32
APP_SECRET=

# Режим входа участников:
#   direct — вход по факту наличия email в списке (без писем)
#   code   — на email дополнительно отправляется одноразовый код (нужен SMTP)
ACCESS_MODE=direct

# Время жизни сессии участника
SESSION_TTL=12h

# --- PostgreSQL ---
POSTGRES_USER=webinar
POSTGRES_PASSWORD=webinar
POSTGRES_DB=webinar

# --- SMTP (нужен только для ACCESS_MODE=code) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- стриминг ---
# Публичный адрес сервера для WebRTC (домен или IP хоста, доступный участникам)
MEDIA_HOST=localhost
# Публичный RTMP-адрес, который показывается ведущему в админке
RTMP_URL=rtmp://localhost:1935/w
