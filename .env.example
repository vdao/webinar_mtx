# Скопируйте в .env и заполните: cp .env.example .env

# --- приложение ---
# Версия образа приложения (тег в реестре). Для серверов лучше пиновать
# конкретный релиз, например 0.0.2; latest — для локальной разработки.
APP_TAG=latest
# Публичный адрес приложения (используется в ссылках и письмах)
APP_URL=http://localhost:8080
# Порт приложения на хосте
APP_PORT=8080

# Доступ администратора (обязательно смените).
# При включённом OIDC пароль не используется, но переменные обязательны:
# ADMIN_EMAIL также служит логином парольного входа (когда OIDC выключен).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# APP_SECRET — ключ, которым приложение подписывает cookie-сессии:
# сессию админа, сессии участников в комнатах и OIDC state-cookie.
# Это просто длинная случайная строка: сгенерируйте один раз и сохраните.
#
#   Как заполнить:  openssl rand -hex 32
#   → вставьте вывод (64 hex-символа) в APP_SECRET=
#
# Почему это важно:
#   • одно и то же значение на всех запусках → сессии живут через рестарты
#     и деплои, участники не «вылетают» с вебинара при обновлении приложения;
#   • смена значения → все существующие сессии мгновенно становятся
#     недействительными (полезно, если ключ скомпрометирован);
#   • пустое значение → при каждом старте генерируется временный ключ:
#     после любого рестарта контейнера всем (и админу, и участникам)
#     придётся входить заново — для продакшена не годится.
# Никому не показывайте значение и не коммитьте его в репозиторий.
APP_SECRET=

# Время жизни сессии участника (после входа по персональной ссылке)
SESSION_TTL=12h

# --- Уведомления о регистрациях (исходящий вебхук) ---
# При каждой новой регистрации (вручную, CSV-импорт, оплата) приложение
# отправляет POST с JSON {email, name, code, link, webinar_*} на этот URL —
# ваша CRM/рассыльщик отправляет участнику письмо с персональной ссылкой.
# Пусто — уведомления отключены (рассылайте ссылки вручную: экспорт CSV).
NOTIFY_WEBHOOK_URL=
# Необязательный секрет: подпись тела запроса в заголовке
# X-Webhook-Signature: sha256=HMAC(тело, секрет)
NOTIFY_WEBHOOK_SECRET=

# Отдельный колбэк (тоже опциональный): при публикации записи вебинара
# каждому активному участнику отправляется событие recording.published
# с email, ФИО и ссылкой на скачивание записи. Шаблонирование письма и
# отправку делает получатель колбэка (ваша CRM/рассыльщик).
NOTIFY_RECORDING_URL=
NOTIFY_RECORDING_SECRET=

# --- PostgreSQL ---
POSTGRES_USER=webinar
POSTGRES_PASSWORD=webinar
POSTGRES_DB=webinar

# --- стриминг ---
# Публичный адрес сервера для WebRTC (домен или IP хоста, доступный участникам)
MEDIA_HOST=localhost
# Публичный RTMP-адрес, который показывается ведущему в админке
RTMP_URL=rtmp://localhost:1935/w

# --- OIDC: вход в админку через SSO (не затрагивает страницы участников) ---
# true — парольный вход отключается, админка пускает только через провайдера.
# В провайдере (Keycloak/Entra ID/Google и т.п.) зарегистрируйте приложение с
# redirect URI: {APP_URL}/admin/oidc/callback
OIDC_ENABLED=false
# Base URL провайдера (без /.well-known/...), например:
#   https://keycloak.example.com/realms/main
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Необязательно: если провайдер требует иной redirect URI
OIDC_REDIRECT_URL=
# Группа из claim "groups" в ID-токене, дающая доступ в админку.
# Убедитесь, что провайдер включает claim "groups" в токен
# (в Keycloak — client scope "groups" / маппер, в Dex — groupsClaim...).
# По умолчанию: admin
OIDC_ADMIN_GROUP=admin

# --- S3: хранилище записей вебинаров (публикация включается, только если
#     заполнены ENDPOINT, BUCKET, ACCESS_KEY, SECRET_KEY и PUBLIC_URL) ---
# Хост S3-endpoint: s3.amazonaws.com, storage.yandexcloud.net, 127.0.0.1:9000 (MinIO)…
S3_ENDPOINT=
# false — только для локальных тестов (MinIO без TLS)
S3_SECURE=true
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публичный базовый URL бакета, из которого строятся ссылки для скачивания:
#   https://bucket.s3.eu-central-1.amazonaws.com  (AWS)
#   https://storage.yandexcloud.net/my-bucket     (Yandex Object Storage)
#   http://localhost:9000/my-bucket                (локальный MinIO)
S3_PUBLIC_URL=
# Префикс (папка) внутри бакета
S3_PREFIX=recordings
